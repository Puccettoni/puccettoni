# --- Server ---
PORT=3000

# --- Phase 0 pricing mock (real total comes from Toast /prices in Phase 2) ---
# Broward County, FL sales tax (6% state + 1% county). Adjust if needed.
TAX_RATE=0.07

# --- Telephony (optional in Phase 0: if missing, SMS/transfer are logged, not sent) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=          # the agent's number (forwards 754-307-4992)
STORE_TRANSFER_NUMBER=        # front-of-house line for transfer_to_human
KITCHEN_BRIDGE_SMS_TO=        # phone that receives the "kitchen ticket" in the demo (your cell)

# --- Toast (Phase 2 — not used in Phase 0) ---
TOAST_CLIENT_ID=
TOAST_CLIENT_SECRET=
TOAST_API_HOSTNAME=
TOAST_RESTAURANT_GUID=
TOAST_PICKUP_DINING_OPTION_GUID=

# --- 86 / out-of-stock (Phase 0 mock: comma-separated item names that are unavailable) ---
# Example: EIGHTY_SIX=Truffle Premium,Burrata
EIGHTY_SIX=

# --- Demo ---
# Force "open" regardless of the clock, to rehearse the full order flow any time.
DEMO_FORCE_OPEN=false
